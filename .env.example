# Trellis environment variables

# ── Storage ────────────────────────────────────────────────────────────────
# Path to the SQLite event-store database (default: ~/.cache/trellis/trellis.db)
# TRELLIS_DB_PATH=

# ── LLM ────────────────────────────────────────────────────────────────────
# API key for an HTTP LLM endpoint (falls back to OPENAI_API_KEY).
# Not required for Pi-backed provider/model IDs; Pi uses ~/.pi/agent/auth.json.
# TRELLIS_LLM_API_KEY=
# Base URL for an HTTP LLM endpoint (falls back to OPENAI_BASE_URL).
# Omit for Pi-backed provider/model IDs.
# TRELLIS_LLM_BASE_URL=
# Model name or exact Pi provider/model ID (falls back to OPENAI_MODEL).
# TRELLIS_LLM_MODEL=

# ── Search provider (search-mcp adapter) ───────────────────────────────────
# Path to search-mcp's MCP server entrypoint (e.g. /path/to/search-mcp/dist/index.js)
# TRELLIS_SEARCH_MCP_PATH=
# Command to spawn (default: node)
# TRELLIS_SEARCH_MCP_COMMAND=node
# Space-separated args (used when TRELLIS_SEARCH_MCP_PATH is unset)
# TRELLIS_SEARCH_MCP_ARGS=

# ── Logging ────────────────────────────────────────────────────────────────
# Log level (default: info). Options: trace, debug, info, warn, error, fatal
# LOG_LEVEL=info
